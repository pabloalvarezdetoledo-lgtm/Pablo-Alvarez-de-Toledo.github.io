---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import EntryCover from "@/components/EntryCover.astro";
import DocumentActions from "@/components/DocumentActions.astro";
import CitationBlock from "@/components/CitationBlock.astro";
import RelatedContent from "@/components/RelatedContent.astro";
import { t } from "@/i18n/dictionary";
import { sectionPath } from "@/i18n/config";
import { entrySlug, findTranslation } from "@/lib/content";
import { resolveResearchRelated, resolveEssaysRelated } from "@/lib/related";
import { articleSchema, breadcrumbSchema } from "@/lib/structuredData";

const locale = "es" as const;

export async function getStaticPaths() {
  const entries = await getCollection("portfolio");
  const es = entries.filter((e) => e.id.startsWith("es/"));
  return es.map((entry) => ({
    params: { slug: entry.id.replace(/^es\//, "") },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const dict = t(locale);

const allPortfolio = await getCollection("portfolio");
const englishTranslation = findTranslation(allPortfolio, entry.data.translationKey, "en");
const langTargets = {
  es: `${sectionPath("portfolio", "es")}${entrySlug(entry)}/`,
  en: englishTranslation
    ? `${sectionPath("portfolio", "en")}${entrySlug(englishTranslation)}/`
    : sectionPath("portfolio", "en"),
};

const related = [
  ...(await resolveResearchRelated(entry.data.relatedResearch, locale, dict.nav.research)),
  ...(await resolveEssaysRelated(entry.data.relatedEssays, locale, dict.nav.essays)),
];

const path = `${sectionPath("portfolio", locale)}${entrySlug(entry)}/`;
const structuredData = [
  articleSchema(Astro.site, {
    title: entry.data.title,
    description: entry.data.description,
    date: entry.data.date,
    updatedDate: entry.data.updatedDate,
    path,
  }),
  breadcrumbSchema(Astro.site, [
    { name: dict.nav.portfolio, path: sectionPath("portfolio", locale) },
    { name: entry.data.title, path },
  ]),
];
---

<BaseLayout
  locale={locale}
  title={entry.data.title}
  description={entry.data.description}
  path={path}
  alternates={langTargets}
  langTargets={langTargets}
  current="portfolio"
  seoType="article"
  structuredData={structuredData}
>
  <article class="section entry">
    <div class="container measure-wide">
      <Breadcrumbs
        items={[
          { label: dict.nav.portfolio, href: sectionPath("portfolio", locale) },
          { label: entry.data.title },
        ]}
      />

      <h1>{entry.data.title}</h1>
      {entry.data.subtitle && <p class="entry__subtitle">{entry.data.subtitle}</p>}

      <div class="entry__meta">
        <span>{dict.doc.date}: {new Intl.DateTimeFormat("es-ES", { year: "numeric", month: "long" }).format(entry.data.date)}</span>
        <span>{dict.doc.language}: {entry.data.documentLanguage.toUpperCase()}</span>
        <span>{dict.doc.status}: {entry.data.status}</span>
      </div>

      <EntryCover
        title={entry.data.title}
        tags={entry.data.tags}
        locale={locale}
        cover={entry.data.cover}
        coverAlt={entry.data.coverAlt}
        coverCaption={entry.data.coverCaption}
        coverCredit={entry.data.coverCredit}
        focalPoint={entry.data.focalPoint}
        loading="eager"
      />

      <DocumentActions locale={locale} pdf={entry.data.pdf} code={entry.data.code} data={entry.data.data} />

      <section>
        <h2>{dict.doc.problem}</h2>
        <p>{entry.data.problem}</p>
      </section>
      <section>
        <h2>{dict.doc.approach}</h2>
        <p>{entry.data.approach}</p>
      </section>
      <section>
        <h2>{dict.doc.result}</h2>
        <p>{entry.data.result}</p>
      </section>

      {entry.data.tools.length > 0 && (
        <section>
          <h2>{dict.doc.toolsAndMethods}</h2>
          <ul class="card__tags">{entry.data.tools.map((tool) => <li class="tag">{tool}</li>)}</ul>
        </section>
      )}
      {entry.data.skills.length > 0 && (
        <section>
          <h2>{dict.doc.skillsDemonstrated}</h2>
          <ul class="card__tags">{entry.data.skills.map((skill) => <li class="tag">{skill}</li>)}</ul>
        </section>
      )}

      <div class="entry__body">
        <Content />
      </div>

      {entry.data.citation && <CitationBlock locale={locale} citation={entry.data.citation} />}

      <RelatedContent locale={locale} items={related} />
    </div>
  </article>
</BaseLayout>

<style>
  .entry__subtitle {
    font-size: var(--step-1);
    color: var(--fg-muted);
  }
  .entry__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    font-size: var(--step--1);
    color: var(--fg-muted);
    margin-bottom: var(--space-6);
  }
  .entry :global(.entry-cover) {
    margin-bottom: var(--space-6);
  }
  .entry__body {
    margin-top: var(--space-6);
  }
</style>
