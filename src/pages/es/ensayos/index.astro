---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import EssayCard from "@/components/EssayCard.astro";
import CategoryNav from "@/components/CategoryNav.astro";
import TagFilter from "@/components/TagFilter.astro";
import EmptyState from "@/components/EmptyState.astro";
import { t } from "@/i18n/dictionary";
import { essayCategoryPath, type EssayCategoryKey } from "@/i18n/config";
import { withBase } from "@/lib/url";
import { byLocale, byDateDesc, entrySlug } from "@/lib/content";

const locale = "es" as const;
const dict = t(locale);

const entries = byDateDesc(byLocale(await getCollection("essays"), locale));
const tags = [...new Set(entries.flatMap((e) => e.data.tags))].sort();
const languages = [...new Set(entries.map((e) => e.data.documentLanguage))];

const langTargets = { en: "/en/essays/", es: "/es/ensayos/" };
---

<BaseLayout
  locale={locale}
  title={dict.section.essays.title}
  description={dict.section.essays.intro}
  path="/es/ensayos/"
  alternates={{ en: "/en/essays/", es: "/es/ensayos/" }}
  langTargets={langTargets}
  current="essays"
>
  <section class="section">
    <div class="container">
      <h1>{dict.section.essays.title}</h1>
      <p class="measure-wide">{dict.section.essays.intro}</p>

      <CategoryNav locale={locale} />

      {entries.length > 0 && (
        <TagFilter locale={locale} tags={tags} languages={languages} targetListId="essays-list" />
      )}

      {
        entries.length === 0 ? (
          <EmptyState locale={locale} />
        ) : (
          <div id="essays-list" class="grid grid--3">
            {entries.map((entry) => (
              <div data-tags={entry.data.tags.join("|")} data-language={entry.data.documentLanguage}>
                <EssayCard
                  href={withBase(essayCategoryPath(entry.data.category as EssayCategoryKey, locale) + entrySlug(entry) + "/")}
                  title={entry.data.title}
                  subtitle={entry.data.subtitle}
                  description={entry.data.description}
                  date={entry.data.date}
                  category={entry.data.category}
                  status={entry.data.status}
                  featured={entry.data.featured}
                  tags={entry.data.tags}
                  locale={locale}
                  cover={entry.data.cover}
                  coverAlt={entry.data.coverAlt}
                />
              </div>
            ))}
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>
