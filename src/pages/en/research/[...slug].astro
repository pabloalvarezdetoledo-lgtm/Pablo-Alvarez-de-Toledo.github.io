---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import EntryCover from "@/components/EntryCover.astro";
import DocumentActions from "@/components/DocumentActions.astro";
import CitationBlock from "@/components/CitationBlock.astro";
import RelatedContent from "@/components/RelatedContent.astro";
import { t } from "@/i18n/dictionary";
import { sectionPath } from "@/i18n/config";
import { entrySlug, findTranslation } from "@/lib/content";
import { categoryThemes } from "@/site.config";
import { resolveResearchRelated, resolvePortfolioRelated, resolveEssaysRelated } from "@/lib/related";
import { scholarlyArticleSchema, breadcrumbSchema } from "@/lib/structuredData";

const locale = "en" as const;

export async function getStaticPaths() {
  const entries = await getCollection("research");
  const en = entries.filter((e) => e.id.startsWith("en/"));
  return en.map((entry) => ({
    params: { slug: entry.id.replace(/^en\//, "") },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const dict = t(locale);
const theme = categoryThemes[entry.data.category];

const allResearch = await getCollection("research");
const spanishTranslation = findTranslation(allResearch, entry.data.translationKey, "es");
const langTargets = {
  en: `${sectionPath("research", "en")}${entrySlug(entry)}/`,
  es: spanishTranslation
    ? `${sectionPath("research", "es")}${entrySlug(spanishTranslation)}/`
    : sectionPath("research", "es"),
};

const related = [
  ...(await resolveResearchRelated(entry.data.relatedResearch, locale, dict.nav.research)),
  ...(await resolvePortfolioRelated(entry.data.relatedPortfolio, locale, dict.nav.portfolio)),
  ...(await resolveEssaysRelated(entry.data.relatedEssays, locale, dict.nav.essays)),
];

const path = `${sectionPath("research", locale)}${entrySlug(entry)}/`;
const structuredData = [
  scholarlyArticleSchema(Astro.site, {
    title: entry.data.title,
    description: entry.data.description,
    date: entry.data.date,
    updatedDate: entry.data.updatedDate,
    path,
    tags: entry.data.tags,
  }),
  breadcrumbSchema(Astro.site, [
    { name: dict.nav.research, path: sectionPath("research", locale) },
    { name: entry.data.title, path },
  ]),
];
---

<BaseLayout
  locale={locale}
  title={entry.data.title}
  description={entry.data.description}
  path={path}
  alternates={langTargets}
  langTargets={langTargets}
  current="research"
  seoType="article"
  structuredData={structuredData}
>
  <article class="section entry">
    <div class="container measure-wide">
      <Breadcrumbs
        items={[
          { label: dict.nav.research, href: sectionPath("research", locale) },
          { label: entry.data.title },
        ]}
      />

      <p class="eyebrow" style={`color:${theme.accent}`}>{theme.en}</p>
      <h1>{entry.data.title}</h1>
      {entry.data.subtitle && <p class="entry__subtitle">{entry.data.subtitle}</p>}

      <div class="entry__meta">
        <span>{dict.doc.date}: {new Intl.DateTimeFormat("en-GB", { year: "numeric", month: "long", day: "numeric" }).format(entry.data.date)}</span>
        {entry.data.updatedDate && (
          <span>{dict.card.updated}: {new Intl.DateTimeFormat("en-GB", { year: "numeric", month: "long", day: "numeric" }).format(entry.data.updatedDate)}</span>
        )}
        <span>{dict.doc.language}: {entry.data.documentLanguage.toUpperCase()}</span>
        <span>{dict.doc.status}: {entry.data.status}</span>
      </div>

      <EntryCover
        title={entry.data.title}
        category={entry.data.category}
        locale={locale}
        cover={entry.data.cover}
        coverAlt={entry.data.coverAlt}
        coverCaption={entry.data.coverCaption}
        coverCredit={entry.data.coverCredit}
        focalPoint={entry.data.focalPoint}
        loading="eager"
      />

      <DocumentActions locale={locale} pdf={entry.data.pdf} code={entry.data.code} data={entry.data.data} />

      {entry.data.abstract && (
        <section>
          <h2>{dict.doc.abstract}</h2>
          <p>{entry.data.abstract}</p>
        </section>
      )}
      {entry.data.researchQuestion && (
        <section>
          <h2>{dict.doc.researchQuestion}</h2>
          <p>{entry.data.researchQuestion}</p>
        </section>
      )}
      {entry.data.methodology && (
        <section>
          <h2>{dict.doc.methodology}</h2>
          <p>{entry.data.methodology}</p>
        </section>
      )}
      {entry.data.findings && (
        <section>
          <h2>{dict.doc.findings}</h2>
          <p>{entry.data.findings}</p>
        </section>
      )}

      <div class="entry__body">
        <Content />
      </div>

      {entry.data.tags.length > 0 && (
        <ul class="card__tags">
          {entry.data.tags.map((tag) => <li class="tag">{tag}</li>)}
        </ul>
      )}

      {entry.data.citation && <CitationBlock locale={locale} citation={entry.data.citation} />}

      <RelatedContent locale={locale} items={related} />
    </div>
  </article>
</BaseLayout>

<style>
  .entry__subtitle {
    font-size: var(--step-1);
    color: var(--fg-muted);
  }
  .entry__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    font-size: var(--step--1);
    color: var(--fg-muted);
    margin-bottom: var(--space-6);
  }
  .entry :global(.entry-cover) {
    margin-bottom: var(--space-6);
  }
  .entry__body {
    margin-top: var(--space-6);
  }
</style>
