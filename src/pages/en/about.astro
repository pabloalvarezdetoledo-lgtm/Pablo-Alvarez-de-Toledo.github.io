---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { t } from "@/i18n/dictionary";
import { sectionPath } from "@/i18n/config";
import { withBase } from "@/lib/url";
import { bio } from "@/site.config";
import { profilePageSchema } from "@/lib/structuredData";

const locale = "en" as const;
const dict = t(locale);
const langTargets = { en: "/en/about/", es: "/es/sobre-mi/" };
---

<BaseLayout
  locale={locale}
  title={dict.about.title}
  description="How Economics and International Business, experience at BBVA, financial training at IEB, and a continuing interest in political economy and philosophy fit together."
  path="/en/about/"
  alternates={{ en: "/en/about/", es: "/es/sobre-mi/" }}
  langTargets={langTargets}
  current="about"
  seoType="profile"
  structuredData={profilePageSchema(Astro.site, "/en/about/")}
>
  <section class="section">
    <div class="container measure-wide">
      <h1>{dict.about.title}</h1>

      <p>
        This site follows a single line of reasoning across formally separate fields. Economics and International
        Business supplied the analytical vocabulary — how markets, firms and countries interact — that experience at
        BBVA then tested against the practical detail of a real financial institution. Financial training at IEB
        added the technical apparatus of valuation and markets that connects that vocabulary to the pricing of
        individual assets.
      </p>
      <p>
        Investment banking and corporate finance are, in this view, the applied end of monetary economics: decisions
        about capital structure, valuation and transactions are decisions made inside the constraints that monetary
        institutions and financial markets set. Econometrics and quantitative finance are the discipline that keeps
        claims about those constraints honest — a claim about how liquidity or duration affects valuation is only as
        good as the method used to test it.
      </p>
      <p>
        The interest in political economy and philosophy is not a departure from this — it is what keeps the
        economic and financial work honest about its own assumptions: about institutions, about rights, and about
        what a person is, prior to any market or any legal order.
      </p>

      <h2>Education</h2>
      <ul class="timeline">
        {bio.en.education.map((item) => (
          <li>
            <h3>{item.title}</h3>
            <p>{item.detail}</p>
          </li>
        ))}
      </ul>

      <h2>Experience</h2>
      <ul class="timeline">
        {bio.en.experience.map((item) => (
          <li>
            <h3>{item.title}</h3>
            <p>{item.detail}</p>
          </li>
        ))}
      </ul>

      <p class="disclaimer">
        Note: this page describes the general connection between Pablo's academic and professional background and
        the research programme of this site. It does not disclose confidential or internal information from any
        organisation named above.
      </p>

      <div class="about__actions">
        <a class="button button--primary" href={withBase(sectionPath("cv", locale))}>{dict.home.heroCvLabel}</a>
        <a class="button" href={withBase(sectionPath("contact", locale))}>{dict.home.heroContactLabel}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .timeline {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-7);
    display: grid;
    gap: var(--space-5);
  }
  .timeline li {
    border-left: 2px solid var(--accent);
    padding-left: var(--space-4);
  }
  .timeline h3 {
    margin-bottom: var(--space-1);
  }
  .disclaimer {
    font-size: var(--step--1);
    color: var(--fg-muted);
    border-top: var(--border-thin);
    padding-top: var(--space-4);
  }
  .about__actions {
    display: flex;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }
</style>
