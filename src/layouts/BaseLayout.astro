---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import SEO from "@/components/SEO.astro";
import StructuredData from "@/components/StructuredData.astro";
import "@/styles/global.css";
import type { Locale, SectionKey } from "@/i18n/config";
import { t } from "@/i18n/dictionary";

export interface Props {
  locale: Locale;
  title: string;
  description: string;
  path: string;
  alternates?: Partial<Record<Locale, string>>;
  langTargets: Record<Locale, string>;
  current?: SectionKey;
  ogImage?: string;
  noindex?: boolean;
  seoType?: "website" | "article" | "profile";
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  locale,
  title,
  description,
  path,
  alternates,
  langTargets,
  current,
  ogImage,
  noindex,
  seoType,
  structuredData,
} = Astro.props;

const nav = t(locale).nav;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23142033'/%3E%3Ctext x='16' y='21' font-family='Georgia,serif' font-size='13' fill='%23F5F1E8' text-anchor='middle'%3EPAT%3C/text%3E%3C/svg%3E" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <SEO
      title={title}
      description={description}
      locale={locale}
      path={path}
      alternates={alternates}
      ogImage={ogImage}
      noindex={noindex}
      type={seoType}
    />
    {structuredData && <StructuredData data={structuredData} />}
  </head>
  <body>
    <a href="#main" class="skip-link">{nav.skipToContent}</a>
    <Header locale={locale} langTargets={langTargets} current={current} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
