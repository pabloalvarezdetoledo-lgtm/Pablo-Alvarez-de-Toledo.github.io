---
import { t } from "@/i18n/dictionary";
import type { Locale } from "@/i18n/config";

export interface Props {
  locale: Locale;
  message?: string;
}
const { locale, message } = Astro.props;
const dict = t(locale).empty;
---

<div class="empty-state">
  <p class="empty-state__title">{message ?? dict.noEntries}</p>
  <p class="empty-state__note">{dict.checkBack}</p>
</div>

<style>
  .empty-state {
    border: 1px dashed var(--rule-strong);
    padding: var(--space-7);
    text-align: center;
    color: var(--fg-muted);
  }
  .empty-state__title {
    font-family: var(--font-display);
    font-size: var(--step-1);
    color: var(--fg);
  }
  .empty-state__note {
    margin: 0;
  }
</style>
