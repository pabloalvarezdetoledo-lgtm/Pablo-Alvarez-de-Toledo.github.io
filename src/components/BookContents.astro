---
import { parts, chaptersInPart, fullTitle } from "@/lib/book";
import { sectionPath, type Locale } from "@/i18n/config";
import { t } from "@/i18n/dictionary";
import { withBase } from "@/lib/url";

export interface Props {
  locale: Locale;
  /** Hide synopses (used on the homepage). */
  compact?: boolean;
}
const { locale, compact = false } = Astro.props;
const dict = t(locale).book;
// Chapter pages exist only in Spanish.
const chapterHref = (slug: string) => withBase(`${sectionPath("book", "es")}${slug}/`);
---

<ol class="book-toc" class:list={[{ "book-toc--compact": compact }]}>
  {
    parts.map((part) => (
      <li class="book-toc__part">
        <p class="book-toc__part-label">
          {dict.part} {part.roman}
        </p>
        <h3 class="book-toc__part-title">{part.title[locale]}</h3>
        <ol class="book-toc__chapters">
          {chaptersInPart(part.number).map((c) => (
            <li class="book-toc__chapter">
              <a href={chapterHref(c.slug)} class="book-toc__link" lang="es">
                <span class="book-toc__num">{c.number}</span>
                <span class="book-toc__title">
                  {locale === "es" ? fullTitle(c) : c.titleEn}
                  {locale === "en" && <span class="book-toc__es">{fullTitle(c)}</span>}
                </span>
              </a>
              {!compact && <p class="book-toc__desc" lang={locale}>{c.description[locale]}</p>}
            </li>
          ))}
        </ol>
      </li>
    ))
  }
</ol>

<style>
  .book-toc,
  .book-toc__chapters {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .book-toc__part {
    padding-block: var(--space-6);
    border-top: var(--border-thin);
  }
  .book-toc__part:first-child {
    border-top: none;
    padding-top: 0;
  }
  .book-toc__part-label {
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 var(--space-1);
  }
  .book-toc__part-title {
    font-size: var(--step-2);
    margin-bottom: var(--space-5);
  }
  .book-toc__chapter + .book-toc__chapter {
    margin-top: var(--space-5);
  }
  .book-toc__link {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    gap: var(--space-3);
    align-items: baseline;
    text-decoration: none;
    color: var(--fg);
  }
  .book-toc__num {
    font-family: var(--font-display);
    font-size: var(--step-1);
    color: var(--fg-muted);
    font-variant-numeric: oldstyle-nums;
  }
  .book-toc__title {
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.3;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.18em;
    text-decoration-thickness: 1px;
    transition: text-decoration-color var(--transition-fast), color var(--transition-fast);
  }
  .book-toc__link:hover .book-toc__title {
    color: var(--accent-dark);
    text-decoration-color: currentColor;
  }
  .book-toc__es {
    display: block;
    font-family: var(--font-body);
    font-size: var(--step--1);
    color: var(--fg-muted);
    font-style: italic;
    margin-top: var(--space-1);
  }
  .book-toc__desc {
    margin: var(--space-2) 0 0 calc(2.25rem + var(--space-3));
    color: var(--fg-muted);
    font-size: var(--step--1);
    max-width: var(--measure-wide);
  }
  .book-toc--compact .book-toc__part {
    padding-block: var(--space-4);
  }
  .book-toc--compact .book-toc__part-title {
    font-size: var(--step-1);
    margin-bottom: var(--space-3);
  }
  .book-toc--compact .book-toc__chapter + .book-toc__chapter {
    margin-top: var(--space-2);
  }
  .book-toc--compact .book-toc__title,
  .book-toc--compact .book-toc__num {
    font-size: var(--step-0);
  }
  @media (max-width: 600px) {
    .book-toc__desc {
      margin-left: 0;
    }
  }
</style>
