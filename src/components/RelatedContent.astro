---
import { t } from "@/i18n/dictionary";
import { withBase } from "@/lib/url";
import type { Locale } from "@/i18n/config";

export interface RelatedItem {
  title: string;
  href: string;
  kind: string;
}
export interface Props {
  locale: Locale;
  items: RelatedItem[];
}
const { locale, items } = Astro.props;
const dict = t(locale).doc;
---

{
  items.length > 0 && (
    <section class="related" aria-label={dict.relatedContent}>
      <h2>{dict.relatedContent}</h2>
      <ul>
        {items.map((item) => (
          <li>
            <span class="related__kind">{item.kind}</span>
            <a href={withBase(item.href)}>{item.title}</a>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .related {
    margin: var(--space-8) 0;
    padding-top: var(--space-6);
    border-top: var(--border-thin);
  }
  .related ul {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
  .related__kind {
    display: inline-block;
    min-width: 6rem;
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--fg-muted);
  }
  .related a {
    text-decoration: none;
    font-weight: 600;
  }
  .related a:hover {
    color: var(--accent-dark);
  }
</style>
