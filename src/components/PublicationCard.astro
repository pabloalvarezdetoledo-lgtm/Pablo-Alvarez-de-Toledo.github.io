---
import EntryCover from "./EntryCover.astro";
import { t } from "@/i18n/dictionary";
import type { Locale } from "@/i18n/config";
import type { CategoryKey } from "@/site.config";

export interface Props {
  href: string;
  title: string;
  subtitle?: string;
  description: string;
  date: Date;
  category: CategoryKey;
  status: "draft" | "working-paper" | "forthcoming" | "published";
  featured?: boolean;
  tags?: string[];
  locale: Locale;
  cover?: ImageMetadata;
  coverAlt?: string;
}

const { href, title, subtitle, description, date, category, status, featured, tags = [], locale, cover, coverAlt } =
  Astro.props;
const dict = t(locale);
const statusLabel = {
  draft: dict.card.draft,
  "working-paper": dict.card.workingPaper,
  forthcoming: dict.card.forthcoming,
  published: dict.card.published,
}[status];
const dateLabel = new Intl.DateTimeFormat(locale === "en" ? "en-GB" : "es-ES", {
  year: "numeric",
  month: "long",
}).format(date);
---

<article class="card">
  <div class="card__cover">
    <EntryCover title={title} category={category} locale={locale} cover={cover} coverAlt={coverAlt} />
  </div>
  <div class="card__body">
    <div class="card__meta">
      {featured && <span class="card__badge">{dict.card.featured}</span>}
      <span>{statusLabel}</span>
      <span aria-hidden="true">·</span>
      <span>{dateLabel}</span>
    </div>
    <h3 class="card__title"><a href={href}>{title}</a></h3>
    {subtitle && <p class="card__subtitle">{subtitle}</p>}
    <p class="card__description">{description}</p>
    {
      tags.length > 0 && (
        <ul class="card__tags" aria-label={dict.doc.tags}>
          {tags.slice(0, 3).map((tag) => (
            <li class="tag" style="position:relative; z-index:1;">
              {tag}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>
