---
import ResponsiveImage from "./ResponsiveImage.astro";
import TypographicCover from "./TypographicCover.astro";
import type { CategoryKey } from "@/site.config";
import type { Locale } from "@/i18n/config";

export interface Props {
  title: string;
  category?: CategoryKey;
  locale: Locale;
  cover?: ImageMetadata;
  coverAlt?: string;
  coverCaption?: string;
  coverCredit?: string;
  focalPoint?: string;
  loading?: "lazy" | "eager";
}

const { title, category, locale, cover, coverAlt, coverCaption, coverCredit, focalPoint, loading = "lazy" } =
  Astro.props;
---

{
  cover ? (
    <figure class="entry-cover">
      <ResponsiveImage src={cover} alt={coverAlt ?? title} focalPoint={focalPoint} loading={loading} />
      {(coverCaption || coverCredit) && (
        <figcaption>
          {coverCaption}
          {coverCredit && <span> — {coverCredit}</span>}
        </figcaption>
      )}
    </figure>
  ) : (
    <TypographicCover title={title} category={category} locale={locale} />
  )
}

<style>
  .entry-cover {
    margin: 0;
  }
  .entry-cover figcaption {
    font-size: var(--step--1);
    color: var(--fg-muted);
    margin-top: var(--space-2);
  }
</style>
