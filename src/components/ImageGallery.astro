---
import Figure from "./Figure.astro";

export interface GalleryItem {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  credit?: string;
}

export interface Props {
  items: GalleryItem[];
}

const { items } = Astro.props;
---

<div class="gallery">
  {items.map((item) => <Figure src={item.src} alt={item.alt} caption={item.caption} credit={item.credit} />)}
</div>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-5);
  }
  .gallery :global(.figure) {
    margin: 0;
  }
</style>
