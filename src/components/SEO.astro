---
import { locales, type Locale } from "@/i18n/config";
import { absoluteUrl } from "@/lib/url";
import { siteDefaults } from "@/site.config";

export interface Props {
  title: string;
  description: string;
  locale: Locale;
  path: string;
  /** Equivalent-page paths per locale, for hreflang alternates. Omit a locale if no translation exists. */
  alternates?: Partial<Record<Locale, string>>;
  ogImage?: string;
  noindex?: boolean;
  type?: "website" | "article" | "profile";
}

const {
  title,
  description,
  locale,
  path,
  alternates = {},
  ogImage = siteDefaults.defaultOgImage,
  noindex = false,
  type = "website",
} = Astro.props;

const fullTitle = `${title} — ${siteDefaults.titleSuffix}`;
const canonical = absoluteUrl(Astro.site, path);
const ogImageUrl = absoluteUrl(Astro.site, ogImage);
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex,follow" />}

{
  locales.map((code) => {
    const altPath = code === locale ? path : alternates[code];
    if (!altPath) return null;
    return <link rel="alternate" hreflang={code} href={absoluteUrl(Astro.site, altPath)} />;
  })
}
<link rel="alternate" hreflang="x-default" href={absoluteUrl(Astro.site, alternates.en ?? path)} />

<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:locale" content={locale === "en" ? "en_US" : "es_ES"} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
