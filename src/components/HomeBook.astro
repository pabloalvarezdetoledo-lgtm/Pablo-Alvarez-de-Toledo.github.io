---
import { book, parts, chaptersInPart, chapters } from "@/lib/book";
import { sectionPath, type Locale } from "@/i18n/config";
import { t } from "@/i18n/dictionary";
import { withBase } from "@/lib/url";

export interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale).book;
const bookHref = withBase(sectionPath("book", locale));
const firstHref = withBase(`${sectionPath("book", "es")}${chapters[0].slug}/`);
---

<section class="section home-book">
  <div class="container home-book__grid">
    <div>
      <p class="eyebrow home-book__eyebrow">{dict.eyebrow}</p>
      <h2>{dict.homeTitle}</h2>
      <p class="home-book__body">{dict.homeBody}</p>
      <p class="home-book__meta">{chapters.length} {dict.chaptersCount} · {parts.length} {locale === "es" ? "partes" : "parts"}</p>
      <div class="home-book__actions">
        <a class="button button--primary" href={bookHref}>{dict.contents}</a>
        <a class="button" href={firstHref}>{dict.readOnline}</a>
        <a class="button button--ghost" href={withBase(book.fullPdf)}>PDF</a>
      </div>
    </div>
    <ol class="home-book__parts">
      {
        parts.map((p) => (
          <li>
            <a href={bookHref}>
              <span class="home-book__roman">{p.roman}</span>
              <span class="home-book__part">{p.title[locale]}</span>
              <span class="home-book__count">{chaptersInPart(p.number).length}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .home-book {
    background: var(--color-navy);
    color: var(--color-ivory);
  }
  .home-book h2 {
    color: var(--color-ivory);
    font-size: var(--step-4);
  }
  .home-book__eyebrow {
    color: #d9b8a8;
  }
  .home-book__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: center;
  }
  .home-book__body {
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.5;
    max-width: var(--measure);
  }
  .home-book__meta {
    font-size: var(--step--1);
    opacity: 0.75;
  }
  .home-book__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
  .home-book .button {
    border-color: var(--color-ivory);
    color: var(--color-ivory);
  }
  .home-book .button:hover,
  .home-book .button--primary {
    background: var(--color-ivory);
    color: var(--color-navy);
  }
  .home-book .button--primary:hover {
    background: transparent;
    color: var(--color-ivory);
    border-color: var(--color-ivory);
  }
  .home-book .button--ghost {
    border-color: rgba(245, 241, 232, 0.4);
  }
  .home-book__parts {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid rgba(245, 241, 232, 0.25);
  }
  .home-book__parts a {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    gap: var(--space-3);
    align-items: baseline;
    padding: var(--space-4) 0;
    border-bottom: 1px solid rgba(245, 241, 232, 0.25);
    text-decoration: none;
    color: var(--color-ivory);
  }
  .home-book__parts a:hover .home-book__part {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .home-book__roman {
    font-family: var(--font-display);
    font-style: italic;
    opacity: 0.7;
  }
  .home-book__part {
    font-family: var(--font-display);
    font-size: var(--step-1);
  }
  .home-book__count {
    font-size: var(--step--1);
    opacity: 0.7;
  }
  @media (max-width: 860px) {
    .home-book__grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }
</style>
